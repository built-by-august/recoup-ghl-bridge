# GoHighLevel Private Integration Token
# From Recoup Studio > Settings > Private Integrations (sub-account level)
GHL_API_TOKEN=paste-your-token-here

# GoHighLevel Location ID (Recoup Studio sub-account UUID)
GHL_LOCATION_ID=paste-your-location-id-here

# GHL API base URL (v2 API)
GHL_API_BASE=https://services.leadconnectorhq.com

# Pipeline: Recoup Engagement Ladder
GHL_PIPELINE_ID=paste-pipeline-id-here
# Pipeline stage UUIDs
GHL_STAGE_LEAD=paste-stage-id-here
GHL_STAGE_AUDIT_BOOKED=paste-stage-id-here
GHL_STAGE_AUDIT_DELIVERED=paste-stage-id-here
GHL_STAGE_PILOT_PROPOSED=paste-stage-id-here
GHL_STAGE_BUILD_ACTIVE=paste-stage-id-here
GHL_STAGE_PARTNER=paste-stage-id-here

# Custom field IDs on Contact object (extracted by Blueprint)
GHL_CF_BUSINESS_TYPE=paste-field-id-here
GHL_CF_COMPANY_SIZE=paste-field-id-here
GHL_CF_WASTE_SIGNALS=paste-field-id-here
GHL_CF_ESTIMATED_WASTE=paste-field-id-here
GHL_CF_AUDIT_DATE=paste-field-id-here
GHL_CF_AUDIT_NOTES_URL=paste-field-id-here

# Port for Railway to bind
PORT=3000
