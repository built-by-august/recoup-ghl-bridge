# GoHighLevel Private Integration Token
# Generate at: sub-account Settings > Private Integrations
GHL_API_TOKEN=

# GoHighLevel Location ID (sub-account ID from GHL URL)
GHL_LOCATION_ID=

# GHL API base URL (default: https://rest.gohighlevel.com/v1)
GHL_API_BASE=https://rest.gohighlevel.com/v1

# Pipeline configuration — set after Blueprint builds the pipeline in GHL
GHL_PIPELINE_ID=
# Pipeline stage UUIDs (set after pipeline is built in GHL)
GHL_STAGE_LEAD=
GHL_STAGE_AUDIT_BOOKED=
GHL_STAGE_AUDIT_DELIVERED=
GHL_STAGE_PILOT_PROPOSED=
GHL_STAGE_BUILD_ACTIVE=
GHL_STAGE_PARTNER=

# Port for Railway to bind
PORT=3000
